CREATE TABLE plantacao (
    id_plantacao INT AUTO_INCREMENT PRIMARY KEY,
    id_produtor INT NOT NULL,
    nome_talhao VARCHAR(100) NOT NULL,
    area_hectares DECIMAL(6,2),
    tipo_cafe VARCHAR(50),
    tipo_solo VARCHAR(50),
    quantidade_plantas INT
);

