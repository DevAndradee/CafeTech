CREATE TABLE dados_sensor (
    id_dado INT AUTO_INCREMENT PRIMARY KEY,
    id_plantacao INT NOT NULL,
    data_hora DATETIME NOT NULL,
    umidade_solo DECIMAL(5,2) NOT NULL,
    temperatura DECIMAL(5,2),
    nivel_umidade VARCHAR(20)

